---
const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'about', i18n: 'nav.about' },
  { href: '/research', label: 'research', i18n: 'nav.research' },
  { href: '/outreach', label: 'outreach', i18n: 'nav.outreach' },
  { href: '/art', label: 'art', i18n: 'nav.art' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header>
  <div class="hero-drawn">
    <div class="name-wrap">
      <div class="hi-label">
        <em data-i18n="nav.greeting">Hi, I'm</em>
        <svg width="38" height="36" viewBox="0 0 62 58" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4,28 C14,18 24,38 34,26 C44,14 54,34 48,52" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>
          <path d="M48,52 L40,44" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M48,52 L56,44" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="name-row">
        <a href="/" class="display-name">
          <span class="n-sans">Vilde</span><span class="n-serif"> Gjærum</span>
        </a>
        <div class="meet-label">
          <svg width="44" height="26" viewBox="0 0 70 42" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2,36 C10,16 20,44 34,24 C44,6 50,24 56,22 L66,22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>
            <path d="M66,22 L59,18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M66,22 L59,26" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <svg class="curved-text" width="170" height="32" viewBox="0 0 170 32">
            <defs>
              <path id="happy-curve" d="M5,16 Q45,32 85,16 Q125,2 165,16" />
            </defs>
            <text font-family="Lora, Georgia, serif" font-style="italic" font-size="13" fill="currentColor">
              <textPath href="#happy-curve" data-i18n="nav.happy">I'm happy you're here!</textPath>
            </text>
          </svg>
        </div>
      </div>
    </div>
  </div>
  <hr class="divider" />
  <nav>
    <ul role="list">
      {links.map((link) => (
        <li>
          <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]} data-i18n={link.i18n}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="controls">
      <div class="pill" id="theme-pill" role="button" tabindex="0" aria-label="Toggle dark mode">
        <span class="pill-label">☀︎</span>
        <div class="track">
          <span class="thumb" id="theme-thumb"></span>
        </div>
        <span class="pill-label">☽</span>
      </div>
      <div class="pill" id="lang-pill" role="button" tabindex="0" aria-label="Toggle language">
        <span class="pill-label">en</span>
        <div class="track">
          <span class="thumb" id="lang-thumb"></span>
        </div>
        <span class="pill-label">no</span>
      </div>
    </div>
  </nav>
</header>

<script>
  // theme
  const themePill = document.getElementById('theme-pill');
  const themeThumb = document.getElementById('theme-thumb');

  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    if (themeThumb) themeThumb.style.transform = dark ? 'translateX(1rem)' : 'translateX(0)';
  }

  applyTheme(localStorage.getItem('theme') !== 'light');

  themePill?.addEventListener('click', () => {
    const isDark = !document.documentElement.classList.contains('dark');
    applyTheme(isDark);
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
  themePill?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); themePill.click(); }
  });

  // lang
  const langPill = document.getElementById('lang-pill');
  const langThumb = document.getElementById('lang-thumb');

  function applyLangToggleUI(isNo: boolean) {
    if (langThumb) langThumb.style.transform = isNo ? 'translateX(1rem)' : 'translateX(0)';
  }

  applyLangToggleUI((localStorage.getItem('lang') || 'en') === 'no');

  langPill?.addEventListener('click', () => {
    const isNo = document.documentElement.lang !== 'no';
    localStorage.setItem('lang', isNo ? 'no' : 'en');
    (window as any).applyLang(isNo ? 'no' : 'en');
    applyLangToggleUI(isNo);
  });
  langPill?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); langPill.click(); }
  });
</script>

<style>
  header {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.5rem 2rem 0;
  }

  .hero-drawn {
    display: flex;
    justify-content: center;
    padding: 1rem 0 0.75rem;
  }

  .name-wrap {
    display: flex;
    flex-direction: column;
  }

  .hi-label {
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: -0.4rem;
    margin-left: -3rem;
  }

  .hi-label em {
    display: inline-block;
    transform: rotate(-30deg);
    margin-top: 0.5rem;
  }

  .hi-label svg {
    color: var(--text-muted);
    transform: translateY(-6px);
  }

  .name-row {
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .display-name {
    display: block;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-decoration: none;
    white-space: nowrap;
  }

  .n-sans {
    font-family: var(--font-sans);
    font-weight: 800;
    color: var(--text);
  }

  .n-serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--text);
  }

  .display-name:hover .n-sans,
  .display-name:hover .n-serif {
    color: var(--accent);
  }

  .meet-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    padding-bottom: 0.1rem;
  }

  .meet-label svg {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .curved-text {
    overflow: visible;
    transform: rotate(-15deg);
    transform-origin: left center;
    margin-top: 10px;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0;
  }

  ul {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--text-muted);
    letter-spacing: 0.01em;
    transition: color 0.15s;
  }

  .nav-link:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .nav-link.active {
    color: var(--accent-soft);
    text-decoration: underline;
    text-decoration-color: var(--accent-soft);
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }

  .controls {
    display: flex;
    gap: 1rem;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    user-select: none;
  }

  .pill-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    line-height: 1;
    letter-spacing: 0.03em;
    transition: color 0.15s;
  }

  .pill:hover .pill-label {
    color: var(--text);
  }

  .track {
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    background: var(--border);
    transition: background 0.2s;
  }

  .thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--text-muted);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), background 0.2s;
    display: block;
  }

  @media (max-width: 600px) {
    header {
      padding: 1rem 1.5rem 0;
    }

    ul {
      gap: 1.5rem;
    }
  }
</style>
