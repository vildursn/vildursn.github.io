---
const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'about' },
  { href: '/research', label: 'research' },
  { href: '/talks', label: 'talks' },
  { href: '/art', label: 'art' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header>
  <nav>
    <a href="/" class="site-name">Vilde Gjærum</a>
    <ul role="list">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class:list={['nav-link', { active: isActive(href) }]}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="controls">
    <div class="pill" id="theme-pill" role="button" tabindex="0" aria-label="Toggle dark mode">
      <span class="pill-label">☀︎</span>
      <div class="track">
        <span class="thumb" id="theme-thumb"></span>
      </div>
      <span class="pill-label">☽</span>
    </div>
    <div class="pill" id="lang-pill" role="button" tabindex="0" aria-label="Toggle language">
      <span class="pill-label">en</span>
      <div class="track">
        <span class="thumb" id="lang-thumb"></span>
      </div>
      <span class="pill-label">no</span>
    </div>
  </div>
</header>

<script>
  // theme
  const themePill = document.getElementById('theme-pill');
  const themeThumb = document.getElementById('theme-thumb');

  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    if (themeThumb) themeThumb.style.transform = dark ? 'translateX(1rem)' : 'translateX(0)';
  }

  applyTheme(localStorage.getItem('theme') !== 'light');

  themePill?.addEventListener('click', () => {
    const isDark = !document.documentElement.classList.contains('dark');
    applyTheme(isDark);
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
  themePill?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); themePill.click(); }
  });

  // lang (placeholder — no actual functionality yet)
  const langPill = document.getElementById('lang-pill');
  const langThumb = document.getElementById('lang-thumb');
  let langIsNo = false;

  langPill?.addEventListener('click', () => {
    langIsNo = !langIsNo;
    if (langThumb) langThumb.style.transform = langIsNo ? 'translateX(1rem)' : 'translateX(0)';
  });
  langPill?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); langPill.click(); }
  });
</script>

<style>
  header {
    border-bottom: 1px solid var(--border);
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-name {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }

  .site-name:hover {
    color: var(--accent);
    text-decoration: none;
  }

  ul {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--text-muted);
    letter-spacing: 0.01em;
    transition: color 0.15s;
  }

  .nav-link:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .nav-link.active {
    color: var(--accent-soft);
    text-decoration: underline;
    text-decoration-color: var(--accent-soft);
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }

  .controls {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.5rem 2rem 0.75rem;
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    user-select: none;
  }

  .pill-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    line-height: 1;
    letter-spacing: 0.03em;
    transition: color 0.15s;
  }

  .pill:hover .pill-label {
    color: var(--text);
  }

  .track {
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    background: var(--border);
    transition: background 0.2s;
  }

  .thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--text-muted);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), background 0.2s;
    display: block;
  }

  @media (max-width: 600px) {
    nav {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem 1.5rem;
    }

    ul {
      gap: 1.5rem;
    }

    .controls {
      padding: 0.25rem 1.5rem 0.75rem;
      justify-content: center;
    }
  }
</style>
