---
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Vilde Gjærum — AI researcher' } = Astro.props;
const pageTitle = title === 'Vilde Gjærum' ? title : `${title} · Vilde Gjærum`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <script is:inline>
    if (localStorage.getItem('theme') !== 'light') {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body>
  <Nav />
  <main>
    <slot />
  </main>

  <div class="theme-switch" id="theme-switch" role="button" tabindex="0" aria-label="Toggle dark mode">
    <span class="moon">☽</span>
    <div class="track">
      <span class="thumb" id="theme-thumb"></span>
    </div>
    <span class="sun">☀︎</span>
  </div>

  <script>
    const switcher = document.getElementById('theme-switch');
    const thumb = document.getElementById('theme-thumb');

    function applyTheme(dark: boolean) {
      document.documentElement.classList.toggle('dark', dark);
      if (thumb) thumb.style.transform = dark ? 'translateX(-50%) translateY(0)' : 'translateX(-50%) translateY(1.375rem)';
    }

    applyTheme(localStorage.getItem('theme') !== 'light');

    switcher?.addEventListener('click', () => {
      const isDark = !document.documentElement.classList.contains('dark');
      applyTheme(isDark);
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });

    switcher?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        switcher.click();
      }
    });
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg: #F2EFE8;
    --surface: #FAF7F1;
    --primary: #5F7558;
    --secondary: #7B8B6F;
    --accent: #B08968;
    --accent-soft: #A3B18A;
    --text: #2F2A24;
    --text-muted: #6B6257;
    --border: #DDD6CA;
    --font-serif: 'Lora', Georgia, serif;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --max-width: 760px;
  }

  .dark {
    --bg: #161A17;
    --surface: #202722;
    --primary: #6E846B;
    --secondary: #95A38C;
    --accent: #B08968;
    --accent-soft: #7C8A6D;
    --text: #ECE7DF;
    --text-muted: #B7B1A8;
    --border: #313933;
  }

  html {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration-color: var(--border);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.15s, text-decoration-color 0.15s;
  }

  a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  img {
    max-width: 100%;
    display: block;
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3.5rem 2rem 6rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .theme-switch {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 50;
    cursor: pointer;
    user-select: none;
  }

  .theme-switch .moon,
  .theme-switch .sun {
    font-size: 0.75rem;
    line-height: 1;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .theme-switch:hover .moon,
  .theme-switch:hover .sun {
    color: var(--text);
  }

  .theme-switch .track {
    width: 1.25rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: var(--border);
    position: relative;
    transition: background 0.25s;
  }

  .theme-switch .thumb {
    position: absolute;
    top: 0.1875rem;
    left: 50%;
    transform: translateX(-50%) translateY(0);
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--text-muted);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), background 0.25s;
    display: block;
  }

  @media (max-width: 600px) {
    main {
      padding: 2rem 1.5rem 4rem;
    }

    h1 {
      font-size: 2rem;
    }

    .theme-switch {
      right: 0.75rem;
    }
  }
</style>
