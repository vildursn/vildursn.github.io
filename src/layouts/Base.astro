---
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Vilde Gjærum — AI researcher' } = Astro.props;
const pageTitle = title === 'Vilde Gjærum' ? title : `${title} · Vilde Gjærum`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <script is:inline>
    if (localStorage.getItem('theme') !== 'light') {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body>
  <Nav />
  <main>
    <slot />
  </main>

</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg: #F2EFE8;
    --surface: #FAF7F1;
    --primary: #5F7558;
    --secondary: #7B8B6F;
    --accent: #B08968;
    --accent-soft: #A3B18A;
    --text: #2F2A24;
    --text-muted: #6B6257;
    --border: #DDD6CA;
    --font-serif: 'Lora', Georgia, serif;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --max-width: 760px;
  }

  .dark {
    --bg: #161A17;
    --surface: #202722;
    --primary: #6E846B;
    --secondary: #95A38C;
    --accent: #B08968;
    --accent-soft: #7C8A6D;
    --text: #ECE7DF;
    --text-muted: #B7B1A8;
    --border: #313933;
  }

  html {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration-color: var(--border);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.15s, text-decoration-color 0.15s;
  }

  a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  img {
    max-width: 100%;
    display: block;
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3.5rem 2rem 6rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  @media (max-width: 600px) {
    main {
      padding: 2rem 1.5rem 4rem;
    }

    h1 {
      font-size: 2rem;
    }
  }
</style>
