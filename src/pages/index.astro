---
import Base from '../layouts/Base.astro';
import { socialLinks } from '../data/social';
---

<Base
  title="Vilde Gjærum"
  description="AI researcher — about, publications, and talks"
>
  <section class="hero">
    <h1>Vilde Gjærum</h1>
    <p class="subtitle">AI researcher</p>
    <div class="rule" aria-hidden="true"></div>
  </section>

  <section class="bio">
    <p>
      <!-- TODO: write your bio here -->
      I'm a researcher working on [your research area] at [your institution].
      My work focuses on [brief description of your research interests and what
      draws you to them].
    </p>
    <p>
      [A second paragraph — your background, what drives you, or anything else
      you'd like people to know.]
    </p>
  </section>

  <nav class="social" aria-label="Links">
    {socialLinks.map(({ label, url }) => (
      <a
        href={url}
        target={url.startsWith('mailto:') ? undefined : '_blank'}
        rel={url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
      >
        {label}
      </a>
    ))}
  </nav>
</Base>

<style>
  .hero {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: 3.5rem;
    letter-spacing: -0.03em;
  }

  .subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .rule {
    width: 2rem;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
    margin-top: 2rem;
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.75rem;
    max-width: 58ch;
    line-height: 1.75;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .social a {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
    letter-spacing: 0.01em;
  }

  .social a:hover {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 2.5rem;
    }
  }
</style>
