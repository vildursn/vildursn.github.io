---
import Base from '../layouts/Base.astro';
import { socialLinks } from '../data/social';
---

<Base
  title="Vilde Gjærum"
  description="AI developer — about, research, and outreach"
>
  <section class="hero">
    <h1>Vilde Gjærum</h1>
    <p class="subtitle">AI developer</p>
  </section>

  <section class="bio">
    <p>
      I hold an MSc in Cybernetics and Robotics and a PhD in Explainable AI,
      both from NTNU. My research focused on making AI systems more transparent
      — understanding not just what a model predicts, but why.
    </p>
    <p>
      Today I work as an AI developer at <a href="https://www.dips.com" target="_blank" rel="noopener noreferrer">DIPS</a>,
      a Norwegian company building software that clinicians rely on every day.
      My work focuses on NLP for clinical text and the infrastructure that makes
      AI reliable in high-stakes environments.
    </p>
    <p>
      I'm drawn to two things: wanting to understand how these systems actually
      work, and wanting them to be genuinely useful for real people.
    </p>
  </section>

  <nav class="social" aria-label="Links">
    {socialLinks.map(({ label, url }) => (
      <a
        href={url}
        target={url.startsWith('mailto:') ? undefined : '_blank'}
        rel={url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
      >
        {label}
      </a>
    ))}
  </nav>
</Base>

<style>
  .hero {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: 3.5rem;
    letter-spacing: -0.03em;
  }

  .subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

.bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.75rem;
    max-width: 58ch;
    line-height: 1.75;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .social a {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
    letter-spacing: 0.01em;
  }

  .social a:hover {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 2.5rem;
    }
  }
</style>
