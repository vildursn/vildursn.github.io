---
import Base from '../layouts/Base.astro';
import FeaturedPhotos from '../components/FeaturedPhotos.astro';
import { socialLinks } from '../data/social';
import { featuredPhotos } from '../data/featured';
---

<Base
  title="Vilde Gjærum"
  description="AI developer — about, research, and outreach"
>
  <section class="hero-drawn">
    <div class="hi-label">
      <em>Hi, I'm</em>
      <svg width="62" height="50" viewBox="0 0 62 50" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M56,16 C56,6 38,2 22,7 C8,12 5,26 12,34 C20,43 42,43 52,34 C60,27 56,16 44,14 C34,12 27,18 30,26"
              stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/>
        <path d="M30,26 L22,38" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        <path d="M30,26 L38,36" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    </div>

    <svg class="ladybug-svg" width="72" height="90" viewBox="0 0 72 90" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M36,24 C53,23 67,36 66,54 C65,72 51,83 36,83 C21,83 7,72 6,54 C5,36 19,25 36,24 Z"
            fill="#C05833" stroke="#1A1714" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M36,25 C35,42 36,62 37,83" stroke="#1A1714" stroke-width="1.3" stroke-linecap="round"/>
      <path d="M24,18 C24,10 30,5 36,5 C42,5 48,10 48,18 C48,24 43,26 36,25 C29,24 24,24 24,18 Z"
            fill="#1A1714" stroke="#1A1714" stroke-width="1"/>
      <path d="M30,7 C26,2 20,1 16,4" stroke="#1A1714" stroke-width="1.3" stroke-linecap="round"/>
      <circle cx="15" cy="4" r="2" fill="#1A1714"/>
      <path d="M42,7 C46,2 52,1 56,4" stroke="#1A1714" stroke-width="1.3" stroke-linecap="round"/>
      <circle cx="57" cy="4" r="2" fill="#1A1714"/>
      <path d="M18,46 C18,40 28,40 28,46 C28,52 18,52 18,46 Z" fill="#1A1714"/>
      <path d="M44,46 C44,40 54,40 54,46 C54,52 44,52 44,46 Z" fill="#1A1714"/>
      <path d="M16,64 C16,59 25,59 25,64 C25,69 16,69 16,64 Z" fill="#1A1714"/>
      <path d="M47,64 C47,59 56,59 56,64 C56,69 47,69 47,64 Z" fill="#1A1714"/>
    </svg>

    <h1 class="display-name">
      <span class="n-sans">Vilde</span><span class="n-serif"> Gjærum</span>
    </h1>

    <div class="meet-label">
      <svg width="58" height="34" viewBox="0 0 58 34" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M56,8 C44,3 22,8 10,22" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/>
        <path d="M10,22 L4,14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        <path d="M10,22 L18,28" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      <em>nice to meet you.</em>
    </div>
  </section>

  <section class="bio">
    <p>
      Hi, I'm Vilde — a <span id="rotating-word">researcher</span> based in Norway.
      I build AI that I hope makes the world a little better, give talks to make it feel less scary,
      and make art whenever I can.
    </p>
    <p>
      I'm drawn to making things. Professionally that's meant autonomous drones with
      <a class="tip" data-tip="A student group making autonomous drones for the fun of it" href="https://www.ascendntnu.no" target="_blank" rel="noopener noreferrer">Ascend NTNU</a>,
      satellite oil spill detection at
      <a class="tip" data-tip="Kongsberg Satellite Services — earth observation through satellites" href="https://www.ksat.no" target="_blank" rel="noopener noreferrer">KSAT</a>,
      and now AI for healthcare at
      <a class="tip" data-tip="Norwegian health tech, used by clinicians every day" href="https://www.dips.com" target="_blank" rel="noopener noreferrer">DIPS</a>.
      Outside of work I apply the same energy to whatever hobby I'm currently obsessed with —
      mountain running, ceramics, salsa, crossfit, skiing, volleyball. The list keeps growing.
    </p>
    <p>
      My research is in <span class="tip" data-tip="Explainable AI — making sense of what models actually do">XAI</span>,
      robotics, and machine learning. I have a degree in cybernetics and robotics and a PhD in
      Explainable AI from NTNU — because "what is this model actually doing?" felt like a question
      worth spending years on.
    </p>
  </section>

  <FeaturedPhotos photos={featuredPhotos} />

  <nav class="social" aria-label="Links">
    {socialLinks.map(({ label, url }) => (
      <a
        href={url}
        target={url.startsWith('mailto:') ? undefined : '_blank'}
        rel={url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
      >
        {label}
      </a>
    ))}
  </nav>
</Base>

<script>
  const word = document.getElementById('rotating-word');
  const words = ['AI developer', 'AI researcher', 'hobby artist', 'engineer'];
  let i = 0;

  setInterval(() => {
    if (!word) return;
    word.style.opacity = '0';
    setTimeout(() => {
      i = (i + 1) % words.length;
      word.textContent = words[i];
      word.style.opacity = '1';
    }, 300);
  }, 2500);
</script>

<style>
  .hero-drawn {
    position: relative;
    padding-top: 3rem;
    margin-bottom: 2.75rem;
  }

  .hi-label {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .hi-label svg {
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  .ladybug-svg {
    position: absolute;
    top: 0;
    right: 0;
    width: 56px;
    height: auto;
  }

  .display-name {
    font-size: clamp(3rem, 11vw, 10rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .n-sans {
    font-family: var(--font-sans);
    font-weight: 800;
    color: var(--text);
  }

  .n-serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--text);
  }

  .meet-label {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .meet-label svg {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  @media (min-width: 700px) {
    .display-name {
      white-space: nowrap;
    }
    .ladybug-svg {
      width: 70px;
    }
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.75rem;
    max-width: 58ch;
    line-height: 1.75;
  }

  #rotating-word {
    display: inline-block;
    min-width: 9rem;
    text-align: center;
    color: var(--accent-soft);
    transition: opacity 0.3s ease;
  }

  .tip {
    position: relative;
    cursor: help;
    text-decoration: underline dotted;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }

  .tip::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.75rem;
    line-height: 1.4;
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
    z-index: 10;
  }

  .tip:hover::after {
    opacity: 1;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .social a {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
    letter-spacing: 0.01em;
  }

  .social a:hover {
    color: var(--accent);
  }

</style>
