---
import Base from '../layouts/Base.astro';
import { publications, type Publication } from '../data/publications';
import { projects } from '../data/projects';
import { socialLinks } from '../data/social';

const scholarUrl = socialLinks.find(l => l.label === 'Google Scholar')?.url;

const byYear = publications.reduce<Record<number, Publication[]>>((acc, pub) => {
  (acc[pub.year] ??= []).push(pub);
  return acc;
}, {});

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---

<Base title="Research" description="Research by Vilde Gjærum">
  <h1 data-i18n="research.title">Research</h1>

  <h2 class="section-heading" data-i18n="research.publications">Publications</h2>

  {years.length === 0 ? (
    <p class="empty" data-i18n="research.pubs-empty">Publications coming soon.</p>
  ) : (
    <>
      {years.map(year => (
        <section class="year-group">
          <h2 class="year-label">{year}</h2>
          <ul>
            {byYear[year].map(pub => (
              <li class="pub">
                <p class="title">
                  {pub.url
                    ? <a href={pub.url} target="_blank" rel="noopener noreferrer">{pub.title}</a>
                    : pub.title}
                </p>
                <p class="authors">{pub.authors.join(', ')}</p>
                <p class="venue">{pub.venue}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
      {scholarUrl && (
        <p class="scholar-link">
          <span data-i18n="research.scholar-prefix">See the full list on</span> <a href={scholarUrl} target="_blank" rel="noopener noreferrer">Google Scholar</a>.
        </p>
      )}
    </>
  )}
  <section class="projects-section">
    <h2 data-i18n="research.projects">Research Projects</h2>
    <ul class="project-list">
      {projects.map(project => (
        <li class="project">
          <p class="project-name">
            <a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a>
          </p>
          <p class="project-desc">{project.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  h1 {
    margin-bottom: 2.5rem;
  }

  .section-heading {
    font-size: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .empty {
    color: var(--text-muted);
    font-style: italic;
    margin-top: 1rem;
  }

  .year-group {
    margin-bottom: 2.5rem;
  }

  .year-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--surface);
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .pub {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem;
    margin: 0 -0.75rem;
    border-radius: 6px;
    transition: background 0.15s;
  }

  .pub:hover {
    background: var(--surface);
  }

  .title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .authors,
  .venue {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .venue {
    font-style: italic;
  }

  .scholar-link {
    margin-top: 2.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .projects-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  .projects-section h2 {
    font-size: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .project-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project {
    padding: 1rem 1.25rem;
    background: var(--surface);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: background 0.15s;
  }

  .project:hover {
    background: var(--surface);
  }

  .project-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
  }

  .project-name a {
    text-decoration: none;
  }

  .project-name a:hover {
    color: var(--accent-soft);
  }

  .project-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
